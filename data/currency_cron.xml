<odoo>
    <record id="cron_update_currency_rates" model="ir.cron">
        <field name="name">Actualizar tasas de cambio AFIP automáticamente</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_currency_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall">False</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_admin"/>
    </record>
</odoo>